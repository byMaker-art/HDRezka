<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<settings>
    <category label="Основные">
        <setting id="domain" type="text" label="Адрес сайта / зеркало" default="kinopub.me"/>
        <setting id="dom_protocol" type="labelenum" label="Протокол" values="https|http" default="https"/>
        <setting id="quality" type="labelenum" label="Качество видео" values="select|360p|480p|720p|1080p|1080p Ultra|2K|4K" default="select"/>
        <setting id="translator" type="labelenum" label="Озвучка / Перевод" values="select|default" default="select"/>
        <setting id="description" type="bool" label="Загружать описание и рейтинг" default="true"/>
    </category>
    <category label="Аккаунт HDRezka">
        <setting id="auth_enabled" type="bool" label="Включить авторизацию" default="false"/>
        <setting id="username" type="text" label="Логин или E-mail" default="" enable="eq(-1,true)"/>
        <setting id="password" type="text" option="hidden" label="Пароль" default="" enable="eq(-2,true)"/>
        <setting id="login_action" type="action" label="Проверить авторизацию / Войти" action="RunPlugin(plugin://plugin.video.hdrezka.tv/?mode=login_action)" enable="eq(-3,true)"/>
    </category>
    <category label="Прокси">
        <setting id="use_proxy" type="bool" label="Использовать прокси" default="false"/>
        <setting id="protocol" type="labelenum" label="Тип прокси" values="http|socks5" default="http" enable="eq(-1,true)"/>
        <setting id="proxy_url" type="text" label="Адрес прокси (host:port или user:pass@host:port)" default="" enable="eq(-2,true)"/>
    </category>
</settings>
