<?xml version="1.0" encoding="UTF-8"?>
<addons>
<addon id="plugin.video.hdrezka.tv" name="Hdrezka.tv" version="3.3.2" provider-name="MrStealth, dandy, DesSolo, DayAnger">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
        <import addon="script.module.requests"/>
        <import addon="script.module.inputstreamhelper" optional="true"/>
    </requires>
    <extension point="xbmc.python.pluginsource" provides="video" library="default.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.service" library="service.py"/>
    <extension point="xbmc.addon.metadata">
        <summary>Hdrezka.tv</summary>
        <description>HDREZKA.TV - Фильмы, мультфильмы и сериалы в высоком качестве</description>
        <description>For personal use only</description>
        <platform>all</platform>
        <assets>
            <icon>icon.png</icon>
            <fanart>fanart.jpg</fanart>
        </assets>
    </extension>
</addon>
<addon id="repository.hdrezka" name="HDRezka Repository" version="1.0.0" provider-name="byMaker-art">
    <extension point="xbmc.addon.repository" name="HDRezka Repository">
        <dir minversion="18.9.0">
            <info>https://raw.githubusercontent.com/byMaker-art/HDRezka/main/repo/addons.xml</info>
            <checksum>https://raw.githubusercontent.com/byMaker-art/HDRezka/main/repo/addons.xml.md5</checksum>
            <datadir zip="true">https://raw.githubusercontent.com/byMaker-art/HDRezka/main/repo/zips/</datadir>
        </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary>Репозиторий для автоматического обновления HDRezka</summary>
        <description>Позволяет автоматически обновлять дополнение HDRezka через интернет прямо в Kodi без использования флешек.</description>
        <platform>all</platform>
        <assets>
            <icon>icon.png</icon>
        </assets>
    </extension>
</addon>
</addons>
